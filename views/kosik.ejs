<%- include('partials/head', { title: 'Košík', nav: 'kosik' }) %>

<h1>Košík</h1>
<p class="sub">Skontrolujte množstvá a odošlite žiadanku. Schvaľuje ju vedúci vášho strediska, vydáva sklad.</p>

<% if (riadky.length === 0) { %>
  <div class="empty">
    Košík je prázdny.<br>
    <a class="btn sec sm" style="margin-top:12px" href="<%= base %>/katalog">Prejsť do katalógu</a>
  </div>
<% } else { %>

<div class="panel">
  <table class="tbl">
    <thead>
      <tr>
        <th style="width:56px"></th>
        <th style="width:96px">Kód</th>
        <th>Položka</th>
        <th style="width:150px">Sklad</th>
        <th style="width:150px">Množstvo</th>
        <th style="width:60px"></th>
      </tr>
    </thead>
    <tbody>
    <% riadky.forEach((r, i) => { %>
      <tr>
        <td><%- include('partials/mini', { path: r.foto, kod: r.kod }) %></td>
        <td class="mono"><%= r.kod %></td>
        <td>
          <b><%= r.nazov %></b>
          <% if (r.kind === 'bundle') { %>
            <div style="font-size:12px;color:var(--steel);margin-top:3px">
              Balík: <%= r.komponenty.map(k => `${k.qty}× ${k.code}`).join(', ') %>
            </div>
          <% } %>
        </td>
        <td>
          <% if (r.kind === 'bundle') { %>
            <span class="tag <%= r.dostupnost > 0 ? 'ok' : 'nula' %>"><%= r.dostupnost %> sád</span>
          <% } else { %>
            <span class="tag <%= r.stav %>"><%= r.sklad %> <%= r.jednotka %></span>
          <% } %>
        </td>
        <td>
          <form method="post" action="<%= base %>/kosik/zmenit" style="display:flex;gap:6px">
            <input type="hidden" name="index" value="<%= i %>">
            <input type="number" name="qty" value="<%= r.qty %>" min="0" step="1" style="width:78px">
            <button class="btn sec sm" type="submit">Uložiť</button>
          </form>
        </td>
        <td>
          <form method="post" action="<%= base %>/kosik/zmenit">
            <input type="hidden" name="index" value="<%= i %>">
            <input type="hidden" name="qty" value="0">
            <button class="btn warn sm" type="submit">Odobrať</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<form method="post" action="<%= base %>/kosik/odoslat" style="margin-top:18px;max-width:640px">
  <div class="field">
    <label for="note">Poznámka pre schvaľovateľa (nepovinné)</label>
    <textarea id="note" name="note" rows="3" placeholder="Napr. náhrada za poškodené náradie na linke SMT-1"></textarea>
  </div>
  <div style="display:flex;gap:10px">
    <button class="btn" type="submit">Odoslať žiadanku</button>
    <a class="btn sec" href="<%= base %>/katalog">Pokračovať vo výbere</a>
  </div>
</form>

<form method="post" action="<%= base %>/kosik/vyprazdnit" style="margin-top:12px">
  <button class="btn warn sm" type="submit">Vyprázdniť košík</button>
</form>

<% } %>

<%- include('partials/foot') %>
