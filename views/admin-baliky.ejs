<%- include('partials/head', { title: 'Balíky', nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Balíky'}] }) %>

<div class="hlavicka">
  <div>
    <h1>Balíky</h1>
    <p class="sub">Balík je predpis, nie skladová položka. Pri odoslaní žiadanky sa rozloží na jednotlivé kusy.</p>
  </div>
  <a class="btn" href="<%= base %>/sprava/balik/novy">+ Nový balík</a>
</div>

<% if (baliky.length === 0) { %>
  <div class="empty">Zatiaľ žiadne balíky.<br>
    <a class="btn sm" style="margin-top:12px" href="<%= base %>/sprava/balik/novy">Založiť prvý</a></div>
<% } else { %>
<div class="panel">
  <table class="tbl">
    <thead><tr><th style="width:110px">Kód</th><th>Názov</th><th style="width:160px">Kategória</th>
               <th class="num" style="width:90px">Položiek</th><th style="width:150px"></th></tr></thead>
    <tbody>
    <% baliky.forEach(b => { %>
      <tr style="<%= b.active ? '' : 'opacity:.5' %>">
        <td class="mono"><a href="<%= base %>/sprava/balik/<%= b.id %>"><%= b.code || '—' %></a></td>
        <td><a class="odkaz-ink" href="<%= base %>/sprava/balik/<%= b.id %>"><%= b.name %></a><%= b.active ? '' : ' · neaktívny' %></td>
        <td style="color:var(--steel);font-size:13px"><%= b.cat_name || '—' %></td>
        <td class="num"><%= b.pocet %></td>
        <td style="display:flex;gap:6px">
          <a class="btn sec sm" href="<%= base %>/sprava/balik/<%= b.id %>">Upraviť</a>
          <a class="btn sec sm" href="<%= base %>/balik/<%= b.id %>">Karta</a>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('partials/foot') %>
