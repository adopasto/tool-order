<%- include('partials/head', { title: novy ? 'Nová položka' : p.code, nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Položky', href:'/sprava/polozky'},
               {text: novy ? 'Nová položka' : p.code}] }) %>

<div class="hlavicka">
  <div>
    <h1><%= novy ? 'Nová položka' : p.name %></h1>
    <p class="sub"><%= novy
      ? 'Kód sa použije aj ako názov súboru fotky, preto ho voľ tak, aby sa nemenil.'
      : 'Zmeny sa prejavia v katalógu okamžite.' %></p>
  </div>
  <% if (!novy) { %><a class="btn sec" href="<%= base %>/produkt/<%= p.id %>">Zobraziť kartu</a><% } %>
</div>

<% if (chyba) { %><div class="flash" style="border-left-color:var(--zero)"><%= chyba %></div><% } %>

<form method="post" action="<%= base %>/sprava/polozka/<%= novy ? 'nova' : p.id %>">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">
    <div class="panel">
      <div class="panel-h">Základné údaje</div>
      <div class="panel-b">
        <div class="formrow">
          <div class="field" style="flex:0 0 160px"><label for="code">Kód *</label>
            <input class="mono" type="text" id="code" name="code" value="<%= p.code || '' %>"
                   required maxlength="20" placeholder="NAR-001"></div>
          <div class="field"><label for="name">Názov *</label>
            <input type="text" id="name" name="name" value="<%= p.name || '' %>" required></div>
        </div>
        <div class="field"><label for="description">Popis</label>
          <textarea id="description" name="description" rows="3"><%= p.description || '' %></textarea></div>
        <div class="formrow">
          <div class="field"><label for="category_id">Kategória</label>
            <select id="category_id" name="category_id">
              <option value="">—</option>
              <% kategorie.forEach(c => { %>
                <option value="<%= c.id %>" <%= p.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select></div>
          <div class="field" style="flex:0 0 110px"><label for="unit">Jednotka</label>
            <select id="unit" name="unit">
              <% ['ks','pár','bal','sada','l','m','kg'].forEach(u => { %>
                <option value="<%= u %>" <%= (p.unit || 'ks') === u ? 'selected' : '' %>><%= u %></option>
              <% }) %>
            </select></div>
          <div class="field" style="flex:0 0 130px"><label for="location">Regál / box</label>
            <input type="text" id="location" name="location" value="<%= p.location || '' %>" placeholder="A1-03"></div>
        </div>
        <div style="display:flex;gap:20px;align-items:center">
          <label class="check"><input type="checkbox" name="is_esd" <%= p.is_esd ? 'checked' : '' %>> ESD položka</label>
          <label class="check"><input type="checkbox" name="active" <%= p.active ? 'checked' : '' %>> Aktívna v katalógu</label>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-h">Zásoba</div>
      <div class="panel-b">
        <% if (novy) { %>
          <div class="field"><label for="pociatocny_stav">Počiatočný stav na sklade</label>
            <input type="number" id="pociatocny_stav" name="pociatocny_stav" value="0" min="0" step="any">
            <div class="napoveda">Zapíše sa ako pohyb typu INVENTÚRA – história sedí od prvého kusu.</div></div>
        <% } else { %>
          <dl class="kv" style="margin-bottom:14px">
            <dt>Aktuálny stav</dt>
            <dd><b class="mono" style="font-size:17px"><%= p.stock_qty %></b> <%= p.unit %>
              <span class="napoveda" style="display:inline">— mení sa len cez Sklad</span></dd>
          </dl>
        <% } %>
        <div class="formrow">
          <div class="field"><label for="reorder_point">Signálna zásoba</label>
            <input type="number" id="reorder_point" name="reorder_point" value="<%= p.reorder_point ?? 5 %>" min="0" step="any"></div>
          <div class="field"><label for="reorder_qty">Doobjednať po</label>
            <input type="number" id="reorder_qty" name="reorder_qty" value="<%= p.reorder_qty ?? '' %>" min="0" step="any"></div>
        </div>
        <div class="napoveda">Pri poklese na signálnu zásobu sa položka objaví v zozname „Doobjednať".</div>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:10px;margin-top:18px">
    <button class="btn" type="submit"><%= novy ? 'Založiť položku' : 'Uložiť zmeny' %></button>
    <a class="btn sec" href="<%= base %>/sprava/polozky">Zrušiť</a>
  </div>
</form>

<% if (!novy) { %>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:24px;align-items:start">
    <div class="panel">
      <div class="panel-h">Fotka</div>
      <div class="panel-b">
        <% if (p.image_path) { %>
          <img src="<%= base %>/foto/<%= encodeURIComponent(p.image_path) %>" alt=""
               style="width:100%;max-height:220px;object-fit:contain;background:#f5f6f5;
                      border:1px solid var(--line);border-radius:var(--r);margin-bottom:12px">
        <% } %>
        <form method="post" enctype="multipart/form-data" action="<%= base %>/sprava/polozka/<%= p.id %>/foto"
              style="display:flex;gap:8px;align-items:center">
          <input type="file" name="foto" accept="image/*" style="border:0;padding:0;font-size:13px">
          <button class="btn sec sm" type="submit">Nahrať</button>
        </form>
        <% if (p.image_path) { %>
          <form method="post" action="<%= base %>/sprava/polozka/<%= p.id %>/foto/zmazat" style="margin-top:8px">
            <button class="btn warn sm" type="submit">Odstrániť fotku</button></form>
        <% } %>
        <div class="napoveda">JPG, PNG alebo WEBP do 4 MB. Uloží sa ako <span class="mono"><%= p.code %>.jpg</span>.</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-h">Dodávatelia</div>
      <table class="tbl">
        <% if (dodavatelia.length === 0) { %>
          <tr><td class="napoveda" style="padding:12px">Zatiaľ žiadny dodávateľ.</td></tr>
        <% } %>
        <% dodavatelia.forEach(d => { %>
          <tr>
            <td><%= d.name %><%= d.is_primary ? ' · hlavný' : '' %>
              <div class="mono" style="font-size:11.5px;color:var(--steel)">
                <%= d.supplier_sku || '—' %><%= d.price != null ? ' · ' + d.price.toFixed(2) + ' €' : '' %></div></td>
            <td style="width:60px">
              <form method="post" action="<%= base %>/sprava/polozka/<%= p.id %>/dodavatel/<%= d.id %>/zmazat">
                <button class="btn warn sm" type="submit">×</button></form></td>
          </tr>
        <% }) %>
      </table>
      <div class="panel-b" style="border-top:1px solid var(--line)">
        <form method="post" action="<%= base %>/sprava/polozka/<%= p.id %>/dodavatel">
          <div class="field"><label for="supplier_id">Pridať dodávateľa</label>
            <select id="supplier_id" name="supplier_id" required>
              <option value="">— vyberte —</option>
              <% vsetciDodavatelia.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
            </select></div>
          <div class="formrow">
            <div class="field"><label for="supplier_sku">Kat. číslo</label>
              <input type="text" id="supplier_sku" name="supplier_sku"></div>
            <div class="field"><label for="price">Cena €</label>
              <input type="number" id="price" name="price" step="0.01" min="0"></div>
            <div class="field"><label for="min_order_qty">Min. obj.</label>
              <input type="number" id="min_order_qty" name="min_order_qty" value="1" min="1" step="any"></div>
          </div>
          <label class="check" style="margin-bottom:12px"><input type="checkbox" name="is_primary"> Hlavný dodávateľ</label>
          <button class="btn sec" type="submit">Priradiť</button>
        </form>
      </div>
    </div>
  </div>

  <form method="post" action="<%= base %>/sprava/polozka/<%= p.id %>/zmazat" style="margin-top:24px"
        onsubmit="return confirm('Naozaj zmazať položku <%= p.code %>?')">
    <button class="btn warn sm" type="submit">Zmazať položku</button>
    <span class="napoveda" style="display:inline;margin-left:10px">
      Ak už má históriu pohybov, len sa deaktivuje – evidencia zostane.</span>
  </form>
<% } %>

<%- include('partials/foot') %>
