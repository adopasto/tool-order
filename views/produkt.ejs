<%- include('partials/head', { title: i.code, nav: 'katalog',
      drobky: [{text:'Katalóg', href:'/katalog'},
               {text: i.cat_name || 'Bez kategórie', href: i.category_id ? '/katalog?cat=' + i.category_id : '/katalog'},
               {text: i.code}] }) %>

<div class="hlavicka">
  <div>
    <div class="eyebrow">Karta položky<%= i.is_esd ? ' · ESD' : '' %><%= i.active ? '' : ' · NEAKTÍVNA' %></div>
    <h1><%= i.name %></h1>
    <div class="mono" style="color:var(--steel);font-size:13px"><%= i.code %></div>
  </div>
  <div style="display:flex;gap:8px">
    <% if (['admin','storekeeper'].includes(user.role)) { %>
      <a class="btn" href="<%= base %>/sprava/polozka/<%= i.id %>">Upraviť kartu</a>
    <% } %>
    <a class="btn sec" href="<%= base %>/katalog">Späť do katalógu</a>
  </div>
</div>

<div class="detail">
  <div>
    <div class="panel" style="overflow:hidden">
      <div class="foto">
        <% if (i.image_path) { %>
          <img src="<%= base %>/foto/<%= encodeURIComponent(i.image_path) %>" alt="<%= i.name %>">
        <% } else { %>
          <div class="foto-nic"><span><%= i.code %></span>bez fotky</div>
        <% } %>
      </div>
      <% const max = Math.max(i.stock_qty, i.reorder_point * 2, 1);
         const fill = Math.min(100, (i.stock_qty / max) * 100);
         const mark = Math.min(100, (i.reorder_point / max) * 100); %>
      <div class="binlabel">
        <div class="row">
          <span class="qty"><%= i.stock_qty %><small><%= i.unit %></small></span>
          <span class="tag <%= i.stav %>">
            <%= i.stav === 'ok' ? 'na sklade' : (i.stav === 'nizka' ? 'nízka zásoba' : 'vypredané') %></span>
        </div>
        <div class="gauge">
          <i class="<%= i.stav %>" style="width:<%= fill %>%"></i>
          <b style="left:<%= mark %>%" title="Signálna zásoba"></b>
        </div>
        <div class="gauge-legend">signálna zásoba <%= i.reorder_point %> <%= i.unit %></div>
      </div>
      <% if (i.active) { %>
        <form class="addbox" method="post" action="<%= base %>/kosik/pridat">
          <input type="hidden" name="kind" value="item">
          <input type="hidden" name="id" value="<%= i.id %>">
          <input type="number" name="qty" value="1" min="1" step="1" aria-label="Množstvo">
          <button class="btn sm" type="submit" style="flex:1">Do košíka</button>
        </form>
      <% } else { %>
        <div style="padding:0 13px 13px"><span class="tag nula">položka nie je v katalógu</span></div>
      <% } %>
    </div>

    <% if (['admin','storekeeper'].includes(user.role)) { %>
      <div class="panel" style="margin-top:16px">
        <div class="panel-h">Rýchla akcia</div>
        <div class="panel-b">
          <form method="post" action="<%= base %>/sklad/prijem" style="display:flex;gap:8px;align-items:flex-end">
            <input type="hidden" name="item_id" value="<%= i.id %>">
            <input type="hidden" name="navrat" value="/produkt/<%= i.id %>">
            <div class="field" style="margin:0;flex:1">
              <label for="pr">Naskladniť</label>
              <input type="number" id="pr" name="qty" value="1" min="0.001" step="any">
            </div>
            <button class="btn sec" type="submit">Príjem</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <% if (i.description) { %>
      <div class="panel" style="margin-bottom:16px"><div class="panel-b">
        <p style="margin:0"><%= i.description %></p></div></div>
    <% } %>

    <div class="panel" style="margin-bottom:16px">
      <div class="panel-h">Údaje</div>
      <div class="panel-b">
        <dl class="kv">
          <dt>Kód</dt><dd class="mono"><%= i.code %></dd>
          <dt>Kategória</dt><dd><%= i.cat_name || '—' %></dd>
          <dt>Umiestnenie</dt><dd class="mono"><%= i.location || '—' %></dd>
          <dt>Merná jednotka</dt><dd><%= i.unit %></dd>
          <dt>Signálna zásoba</dt><dd><%= i.reorder_point %> <%= i.unit %></dd>
          <dt>Doobjednať po</dt><dd><%= i.reorder_qty ?? '—' %> <%= i.unit %></dd>
          <dt>ESD</dt><dd><%= i.is_esd ? 'áno – vyžaduje ESD manipuláciu' : 'nie' %></dd>
          <% if (i.ref_price != null) { %>
            <dt>Orientačná cena</dt>
            <dd><%= i.ref_price.toFixed(2) %> € / <%= i.unit %>
              <% if (i.ref_price_note) { %><span class="napoveda" style="display:inline">· <%= i.ref_price_note %></span><% } %></dd>
          <% } %>
          <% if (i.usage_6m != null) { %>
            <dt>Spotreba 6 mes.</dt>
            <dd><%= i.usage_6m %> <%= i.unit %> <span class="napoveda" style="display:inline">podľa importovaného prehľadu</span></dd>
          <% } %>
          <dt>Výdaj za 90 dní</dt><dd><%= i.spotreba90 %> <%= i.unit %><% if (i.spotreba90 > 0) { %>
            <span style="color:var(--steel);font-size:12px">(~<%= (i.spotreba90 / 3).toFixed(1) %> mesačne)</span><% } %></dd>
        </dl>
      </div>
    </div>

    <% if (i.baliky.length) { %>
      <div class="panel" style="margin-bottom:16px">
        <div class="panel-h">Súčasť balíkov</div>
        <table class="tbl">
          <% i.baliky.forEach(b => { %>
            <tr><td class="mono" style="width:90px"><%= b.code || '—' %></td>
                <td><a href="<%= base %>/balik/<%= b.id %>"><%= b.name %></a></td>
                <td class="num" style="width:80px"><%= b.qty %> <%= i.unit %></td></tr>
          <% }) %>
        </table>
      </div>
    <% } %>

    <% if (i.pasma && i.pasma.length) { %>
      <div class="panel" style="margin-bottom:16px">
        <div class="panel-h">Množstevné ceny z ponúk</div>
        <table class="tbl">
          <thead><tr><th style="width:120px">Od množstva</th><th class="num" style="width:100px">Cena/MJ</th>
                     <th>Platí pre</th><th style="width:150px">Ponuka</th></tr></thead>
          <tbody>
          <% i.pasma.forEach(t => { %>
            <tr>
              <td class="mono"><%= t.min_qty %> <%= i.unit %></td>
              <td class="num"><b><%= t.unit_price != null ? t.unit_price.toFixed(2) + ' €' : '—' %></b></td>
              <td style="font-size:12.5px;color:var(--steel)"><%= t.note || '' %></td>
              <td class="mono" style="font-size:12px"><%= t.number %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <div class="panel-b" style="border-top:1px solid var(--line)">
          <% i.ponuky.forEach(q => { %>
            <div style="font-size:13px;margin-bottom:4px">
              <%= q.supplier_name || '—' %> · ponuka <span class="mono"><%= q.number %></span>
              <% if (q.valid_until) { %><span class="napoveda" style="display:inline">platná do <%= q.valid_until %></span><% } %>
              <% if (q.file_path) { %> · <a href="<%= base %>/ponuka/<%= q.id %>/priloha">stiahnuť PDF</a><% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <div class="panel" style="margin-bottom:16px">
      <div class="panel-h">Dodávatelia (referenčne)</div>
      <table class="tbl">
        <% if (i.dodavatelia.length === 0) { %>
          <tr><td style="color:var(--steel)">Položka nemá priradeného dodávateľa.</td></tr>
        <% } %>
        <% i.dodavatelia.forEach(d => { %>
          <tr>
            <td><a href="<%= base %>/dodavatelia/<%= d.id %>"><%= d.name %></a>
              <% if (d.is_primary) { %> <span class="tag ok">hlavný</span><% } %>
              <div style="font-size:12px;color:var(--steel)"><%= d.contact_person || '' %><%= d.phone ? ' · ' + d.phone : '' %> · dodanie ~<%= d.lead_time_days %> dní</div></td>
            <td class="mono" style="width:110px;font-size:12px"><%= d.supplier_sku || '—' %></td>
            <td class="num" style="width:90px"><%= d.price != null ? d.price.toFixed(2) + ' €' : '—' %></td>
          </tr>
        <% }) %>
      </table>
    </div>

    <div class="panel">
      <div class="panel-h">História pohybov</div>
      <table class="tbl">
        <thead><tr><th style="width:150px">Čas</th><th style="width:100px">Typ</th>
                   <th class="num" style="width:90px">Množstvo</th><th style="width:130px">Doklad</th>
                   <th>Kto</th></tr></thead>
        <tbody>
        <% if (i.pohyby.length === 0) { %>
          <tr><td colspan="5" style="color:var(--steel)">Zatiaľ bez pohybov.</td></tr>
        <% } %>
        <% i.pohyby.forEach(m => { %>
          <tr>
            <td class="mono" style="font-size:12px"><%= m.created_at %></td>
            <td class="mono" style="font-size:11.5px"><%= m.move_type %></td>
            <td class="num" style="color:<%= m.qty < 0 ? 'var(--zero)' : 'var(--ok)' %>">
              <%= m.qty > 0 ? '+' : '' %><%= m.qty %> <%= i.unit %></td>
            <td class="mono" style="font-size:12px"><%= m.ziadanka || (m.dodavatel || '') %></td>
            <td style="font-size:13px"><%= m.full_name || '—' %>
              <% if (m.note) { %><div style="font-size:11.5px;color:var(--steel)"><%= m.note %></div><% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
