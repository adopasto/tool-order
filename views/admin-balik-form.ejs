<%- include('partials/head', { title: novy ? 'Nový balík' : (b.code || b.name), nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Balíky', href:'/sprava/baliky'},
               {text: novy ? 'Nový balík' : (b.code || b.name)}] }) %>

<h1><%= novy ? 'Nový balík' : b.name %></h1>
<p class="sub"><%= novy ? 'Najprv ulož hlavičku, potom pridávaj položky.' : 'Zmeny sa prejavia v katalógu okamžite.' %></p>

<% if (chyba) { %><div class="flash" style="border-left-color:var(--zero)"><%= chyba %></div><% } %>

<form method="post" action="<%= base %>/sprava/balik/<%= novy ? 'novy' : b.id %>" style="max-width:820px">
  <div class="panel"><div class="panel-b">
    <div class="formrow">
      <div class="field" style="flex:0 0 160px"><label for="code">Kód</label>
        <input class="mono" type="text" id="code" name="code" value="<%= b.code || '' %>" placeholder="BAL-001"></div>
      <div class="field"><label for="name">Názov *</label>
        <input type="text" id="name" name="name" value="<%= b.name || '' %>" required></div>
      <div class="field" style="flex:0 0 200px"><label for="category_id">Kategória</label>
        <select id="category_id" name="category_id">
          <option value="">—</option>
          <% kategorie.forEach(c => { %>
            <option value="<%= c.id %>" <%= b.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select></div>
    </div>
    <div class="field"><label for="description">Popis</label>
      <textarea id="description" name="description" rows="2"><%= b.description || '' %></textarea></div>
    <label class="check"><input type="checkbox" name="active" <%= (novy || b.active) ? 'checked' : '' %>> Aktívny v katalógu</label>
  </div></div>
  <div style="display:flex;gap:10px;margin-top:16px">
    <button class="btn" type="submit"><%= novy ? 'Založiť balík' : 'Uložiť hlavičku' %></button>
    <a class="btn sec" href="<%= base %>/sprava/baliky">Späť na zoznam</a>
  </div>
</form>

<% if (!novy) { %>
  <h2>Obsah balíka</h2>
  <div class="panel" style="max-width:820px">
    <table class="tbl">
      <thead><tr><th style="width:56px"></th><th style="width:100px">Kód</th><th>Položka</th>
                 <th class="num" style="width:100px">Množstvo</th>
                 <th class="num" style="width:100px">Na sklade</th><th style="width:60px"></th></tr></thead>
      <tbody>
      <% if (komponenty.length === 0) { %>
        <tr><td colspan="6" class="napoveda" style="padding:14px">Balík je zatiaľ prázdny – pridaj prvú položku nižšie.</td></tr>
      <% } %>
      <% komponenty.forEach(k => { %>
        <tr>
          <td><%- include('partials/mini', { path: k.image_path, kod: k.code }) %></td>
          <td class="mono"><%= k.code %></td>
          <td><%= k.name %></td>
          <td class="num"><%= k.qty %> <%= k.unit %></td>
          <td class="num"><%= k.stock_qty %></td>
          <td><form method="post" action="<%= base %>/sprava/balik/<%= b.id %>/komponent/<%= k.id %>/zmazat">
            <button class="btn warn sm" type="submit">×</button></form></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <div class="panel-b" style="border-top:1px solid var(--line)">
      <form method="post" action="<%= base %>/sprava/balik/<%= b.id %>/komponent" class="formrow">
        <div class="field" style="flex:1 1 320px"><label for="item_id">Pridať položku</label>
          <select id="item_id" name="item_id" required>
            <option value="">— vyberte —</option>
            <% polozky.forEach(i => { %><option value="<%= i.id %>"><%= i.code %> – <%= i.name %></option><% }) %>
          </select></div>
        <div class="field" style="flex:0 0 120px"><label for="qty">Množstvo</label>
          <input type="number" id="qty" name="qty" value="1" min="0.001" step="any" required></div>
        <div class="field" style="flex:0 0 auto"><button class="btn sec" type="submit">Pridať</button></div>
      </form>
    </div>
  </div>

  <form method="post" action="<%= base %>/sprava/balik/<%= b.id %>/zmazat" style="margin-top:24px"
        onsubmit="return confirm('Naozaj zmazať balík?')">
    <button class="btn warn sm" type="submit">Zmazať balík</button>
  </form>
<% } %>

<%- include('partials/foot') %>
