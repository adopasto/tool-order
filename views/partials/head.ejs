<!doctype html>
<html lang="sk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Sklad náradia</title>
<link rel="stylesheet" href="<%= base %>/css/app.css?v=<%= verzia %>">
</head>
<body>

<% if (user) { %>
<header class="topbar">
  <div class="topbar-in">
    <a class="brand" href="<%= base %>/katalog">Sklad náradia<small>NEWAYS Slovakia, a.s.</small></a>
    <nav class="nav">
      <a href="<%= base %>/katalog" class="<%= nav === 'katalog' ? 'active' : '' %>">Katalóg</a>
      <a href="<%= base %>/kosik" class="<%= nav === 'kosik' ? 'active' : '' %>">Košík<% if (cartCount) { %><span class="badge"><%= cartCount %></span><% } %></a>
      <a href="<%= base %>/ziadanky" class="<%= nav === 'ziadanky' ? 'active' : '' %>">Žiadanky<% if (naSchvalenie) { %><span class="badge"><%= naSchvalenie %></span><% } %></a>
      <% if (['storekeeper','buyer','admin'].includes(user.role)) { %>
        <a href="<%= base %>/sklad" class="<%= nav === 'sklad' ? 'active' : '' %>">Sklad</a>
        <a href="<%= base %>/sklad/doobjednat" class="<%= nav === 'upozornenia' ? 'active' : '' %>">Doobjednať<% if (alertCount) { %><span class="badge"><%= alertCount %></span><% } %></a>
        <a href="<%= base %>/dodavatelia" class="<%= nav === 'dodavatelia' ? 'active' : '' %>">Dodávatelia</a>
      <% } %>
      <% if (['storekeeper','admin'].includes(user.role)) { %>
        <a href="<%= base %>/sprava" class="<%= nav === 'sprava' ? 'active' : '' %>">Správa</a>
      <% } %>
    </nav>
    <div class="who">
      <b><%= user.full_name %></b>
      <%= user.roleLabel %><%= user.cost_center ? ' · ' + user.cost_center : '' %>
      <form method="post" action="<%= base %>/odhlasenie" style="display:inline">
        <button class="linkbtn" type="submit">Odhlásiť</button>
      </form>
    </div>
  </div>
</header>
<% } %>

<main class="wrap">
<% if (typeof drobky !== 'undefined' && drobky.length) { %>
  <nav class="drobky">
    <% drobky.forEach((d, n) => { %>
      <% if (d.href) { %><a href="<%= base %><%= d.href %>"><%= d.text %></a><% } else { %><span><%= d.text %></span><% } %>
      <% if (n < drobky.length - 1) { %><i>›</i><% } %>
    <% }) %>
  </nav>
<% } %>
<% if (flash) { %><div class="flash"><%= flash %></div><% } %>
