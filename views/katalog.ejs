<%- include('partials/head', { title: 'Katalóg', nav: 'katalog' }) %>

<div class="hlavicka">
  <div>
    <h1>Katalóg</h1>
    <p class="sub">Kliknutím na položku otvoríš jej kartu. Množstvo zadaj priamo tu a pridaj do košíka.</p>
  </div>
  <% if (['admin','storekeeper'].includes(user.role)) { %>
    <div style="display:flex;gap:8px">
      <a class="btn" href="<%= base %>/sprava/polozka/nova">+ Nová položka</a>
      <a class="btn sec" href="<%= base %>/sprava/balik/novy">+ Nový balík</a>
    </div>
  <% } %>
</div>

<div class="cols">
  <aside>
    <div class="panel rail">
      <div class="panel-h">Kategórie</div>
      <div style="padding:6px 0">
        <a href="<%= base %>/katalog?typ=<%= typ %>&zobrazenie=<%= zobrazenie %>" class="<%= !cat ? 'active' : '' %>">
          Všetko<span><%= spolu %></span></a>
        <% kategorie.forEach(k => { %>
          <a href="<%= base %>/katalog?typ=<%= typ %>&zobrazenie=<%= zobrazenie %>&cat=<%= k.id %>"
             class="<%= cat === k.id ? 'active' : '' %>"><%= k.name %><span><%= k.pocet %></span></a>
        <% }) %>
      </div>
    </div>
  </aside>

  <section>
    <div class="toolbar">
      <div class="tabs">
        <a href="<%= base %>/katalog?typ=polozky&zobrazenie=<%= zobrazenie %><%= cat ? '&cat=' + cat : '' %>"
           class="<%= typ === 'polozky' ? 'active' : '' %>">Položky</a>
        <a href="<%= base %>/katalog?typ=baliky&zobrazenie=<%= zobrazenie %><%= cat ? '&cat=' + cat : '' %>"
           class="<%= typ === 'baliky' ? 'active' : '' %>">Balíky</a>
      </div>
      <form class="grow" method="get" action="<%= base %>/katalog" style="display:flex;gap:8px">
        <input type="hidden" name="typ" value="<%= typ %>">
        <input type="hidden" name="zobrazenie" value="<%= zobrazenie %>">
        <% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
        <input type="search" name="q" value="<%= q %>" placeholder="Hľadať podľa názvu, kódu alebo regálu">
        <button class="btn sec" type="submit">Hľadať</button>
        <% if (q) { %><a class="btn sec" href="<%= base %>/katalog?typ=<%= typ %>">Zrušiť</a><% } %>
      </form>
      <div class="tabs">
        <a href="<%= base %>/katalog?typ=<%= typ %>&zobrazenie=dlazdice<%= cat ? '&cat=' + cat : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="<%= zobrazenie === 'dlazdice' ? 'active' : '' %>" title="Dlaždice">▦</a>
        <a href="<%= base %>/katalog?typ=<%= typ %>&zobrazenie=zoznam<%= cat ? '&cat=' + cat : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="<%= zobrazenie === 'zoznam' ? 'active' : '' %>" title="Zoznam">☰</a>
      </div>
    </div>

    <%# ---------------- POLOŽKY ---------------- %>
    <% if (typ === 'polozky') { %>
      <% if (polozky.length === 0) { %>
        <div class="empty">Žiadna položka nezodpovedá filtru.<br>
          <% if (['admin','storekeeper'].includes(user.role)) { %>
            <a class="btn sm" style="margin-top:12px" href="<%= base %>/sprava/polozka/nova">Založiť novú položku</a>
          <% } %></div>

      <% } else if (zobrazenie === 'zoznam') { %>
        <div class="panel">
          <table class="tbl">
            <thead><tr><th style="width:56px"></th><th style="width:96px">Kód</th><th>Položka</th>
                       <th style="width:70px">Regál</th><th class="num" style="width:110px">Na sklade</th>
                       <th style="width:110px">Stav</th><th style="width:180px">Do košíka</th></tr></thead>
            <tbody>
            <% polozky.forEach(p => { %>
              <tr>
                <td><a href="<%= base %>/produkt/<%= p.id %>"><%- include('partials/mini', { path: p.image_path, kod: p.code }) %></a></td>
                <td class="mono"><a href="<%= base %>/produkt/<%= p.id %>"><%= p.code %></a></td>
                <td><a href="<%= base %>/produkt/<%= p.id %>" class="odkaz-ink"><%= p.name %></a>
                  <%= p.is_esd ? ' · ESD' : '' %></td>
                <td class="mono" style="font-size:12px"><%= p.location || '—' %></td>
                <td class="num"><b><%= p.stock_qty %></b> <%= p.unit %></td>
                <td><span class="tag <%= p.stav %>"><%= p.stav === 'ok' ? 'v poriadku' : (p.stav === 'nizka' ? 'nízka' : 'vypredané') %></span></td>
                <td>
                  <form method="post" action="<%= base %>/kosik/pridat" style="display:flex;gap:6px">
                    <input type="hidden" name="kind" value="item">
                    <input type="hidden" name="id" value="<%= p.id %>">
                    <input type="number" name="qty" value="1" min="1" step="1" style="width:64px" aria-label="Množstvo">
                    <button class="btn sm" type="submit">Pridať</button>
                  </form>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>

      <% } else { %>
        <div class="grid">
        <% polozky.forEach(p => {
             const max = Math.max(p.stock_qty, p.reorder_point * 2, 1);
             const fill = Math.min(100, (p.stock_qty / max) * 100);
             const mark = Math.min(100, (p.reorder_point / max) * 100); %>
          <article class="card <%= p.is_esd ? 'esd' : '' %>">
            <a class="karta-odkaz" href="<%= base %>/produkt/<%= p.id %>">
              <div class="foto">
                <% if (p.image_path) { %>
                  <img src="<%= base %>/foto/<%= encodeURIComponent(p.image_path) %>" alt="<%= p.name %>" loading="lazy">
                <% } else { %>
                  <div class="foto-nic"><span><%= p.code %></span>bez fotky</div>
                <% } %>
              </div>
              <div class="card-b">
                <div class="kod"><%= p.code %><%= p.is_esd ? ' · ESD' : '' %></div>
                <div class="nazov"><%= p.name %></div>
                <p class="popis"><%= p.description || '' %></p>
                <div class="meta"><%= p.location ? 'Regál ' + p.location : 'bez umiestnenia' %></div>
              </div>
              <div class="binlabel">
                <div class="row">
                  <span class="qty"><%= p.stock_qty %><small><%= p.unit %></small></span>
                  <span class="tag <%= p.stav %>">
                    <%= p.stav === 'ok' ? 'na sklade' : (p.stav === 'nizka' ? 'nízka zásoba' : 'vypredané') %></span>
                </div>
                <div class="gauge">
                  <i class="<%= p.stav %>" style="width:<%= fill %>%"></i>
                  <b style="left:<%= mark %>%" title="Signálna zásoba"></b>
                </div>
                <div class="gauge-legend">signálna zásoba <%= p.reorder_point %> <%= p.unit %> · otvoriť kartu ›</div>
              </div>
            </a>
            <form class="addbox" method="post" action="<%= base %>/kosik/pridat">
              <input type="hidden" name="kind" value="item">
              <input type="hidden" name="id" value="<%= p.id %>">
              <input type="number" name="qty" value="1" min="1" step="1" aria-label="Množstvo">
              <button class="btn sm" type="submit" style="flex:1">Do košíka</button>
            </form>
          </article>
        <% }) %>
        </div>
      <% } %>

    <%# ---------------- BALÍKY ---------------- %>
    <% } else { %>
      <% if (baliky.length === 0) { %>
        <div class="empty">Zatiaľ tu nie sú žiadne balíky.
          <% if (['admin','storekeeper'].includes(user.role)) { %>
            <br><a class="btn sm" style="margin-top:12px" href="<%= base %>/sprava/balik/novy">Založiť balík</a>
          <% } %></div>
      <% } %>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(330px,1fr))">
      <% baliky.forEach(b => { %>
        <article class="card">
          <a class="karta-odkaz" href="<%= base %>/balik/<%= b.id %>">
            <div class="card-b">
              <div class="kod"><%= b.code || '' %><%= b.cat_name ? ' · ' + b.cat_name : '' %></div>
              <div class="nazov"><%= b.name %></div>
              <p class="popis"><%= b.description || '' %></p>
              <table class="tbl" style="margin-top:10px">
                <% b.komponenty.slice(0, 5).forEach(k => { %>
                  <tr><td class="mono" style="width:88px"><%= k.code %></td>
                      <td><%= k.name %></td>
                      <td class="num" style="width:66px"><%= k.qty %> <%= k.unit %></td></tr>
                <% }) %>
                <% if (b.komponenty.length > 5) { %>
                  <tr><td colspan="3" style="color:var(--steel);font-size:12px">
                    + ďalších <%= b.komponenty.length - 5 %> položiek</td></tr>
                <% } %>
              </table>
            </div>
            <div class="binlabel">
              <div class="row">
                <span class="qty"><%= b.dostupnost %><small>kompletných sád</small></span>
                <span class="tag <%= b.dostupnost > 0 ? 'ok' : 'nula' %>">
                  <%= b.dostupnost > 0 ? 'dostupné' : 'nekompletné' %></span>
              </div>
              <div class="gauge-legend">otvoriť kartu balíka ›</div>
            </div>
          </a>
          <form class="addbox" method="post" action="<%= base %>/kosik/pridat">
            <input type="hidden" name="kind" value="bundle">
            <input type="hidden" name="id" value="<%= b.id %>">
            <input type="number" name="qty" value="1" min="1" step="1" aria-label="Počet sád">
            <button class="btn sm" type="submit" style="flex:1">Do košíka</button>
          </form>
        </article>
      <% }) %>
      </div>
    <% } %>
  </section>
</div>

<%- include('partials/foot') %>
