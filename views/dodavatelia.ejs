<%- include('partials/head', { title: 'Dodávatelia', nav: 'dodavatelia' }) %>

<h1>Dodávatelia</h1>
<p class="sub">Kontakty a rozsah dodávok. Kliknutím na dodávateľa zobrazíte položky, ktoré dodáva.</p>

<div class="panel">
  <table class="tbl">
    <thead>
      <tr><th>Dodávateľ</th><th style="width:170px">Kontaktná osoba</th>
          <th style="width:230px">E-mail</th><th style="width:150px">Telefón</th>
          <th class="num" style="width:90px">Položiek</th><th style="width:90px">Lehota</th></tr>
    </thead>
    <tbody>
    <% dodavatelia.forEach(d => { %>
      <tr>
        <td><a href="<%= base %>/dodavatelia/<%= d.id %>"><b><%= d.name %></b></a>
            <div style="font-size:12px;color:var(--steel)"><%= d.address || '' %><%= d.ico ? ' · IČO ' + d.ico : '' %></div></td>
        <td><%= d.contact_person || '—' %></td>
        <td class="mono" style="font-size:12px"><a href="mailto:<%= d.email %>"><%= d.email || '—' %></a></td>
        <td class="mono" style="font-size:12px"><%= d.phone || '—' %></td>
        <td class="num"><%= d.pocet_poloziek %></td>
        <td class="mono" style="font-size:12px"><%= d.lead_time_days %> dní</td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
