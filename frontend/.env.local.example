# Skopíruj na .env.local (ten je v .gitignore) a uprav podľa potreby.

# FastAPI backend (server-to-server, nie je vidieť z prehliadača).
BACKEND_URL=http://127.0.0.1:8000

# Auth.js - vyžadovaný podpisový kľúč pre session JWT. Vygeneruj napr.:
#   openssl rand -base64 32
AUTH_SECRET=

# AUTH_MODE nechaj prázdne pre lokálny vývoj - zaregistruje sa len dev-login
# (prihlásenie ľubovoľným e-mailom, bez hesla, bez Microsoft konta).
# AUTH_MODE=entra

# Potrebné len ked AUTH_MODE=entra - z Azure Entra App Registration.
# Redirect URI v App Registration: {origin}/api/auth/callback/microsoft-entra-id
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
