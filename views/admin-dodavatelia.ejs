<%- include('partials/head', { title: 'Dodávatelia', nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Dodávatelia'}] }) %>

<div class="hlavicka">
  <div>
    <h1>Dodávatelia</h1>
    <p class="sub">Evidencia kontaktov a rozsahu dodávok. Objednávky vystavuje oddelenie nákupu.</p>
  </div>
  <a class="btn" href="<%= base %>/sprava/dodavatel/novy">+ Nový dodávateľ</a>
</div>

<div class="panel">
  <table class="tbl">
    <thead><tr><th>Dodávateľ</th><th style="width:170px">Kontakt</th><th style="width:220px">E-mail</th>
               <th style="width:140px">Telefón</th><th class="num" style="width:90px">Položiek</th>
               <th style="width:80px">Lehota</th><th style="width:100px"></th></tr></thead>
    <tbody>
    <% dodavatelia.forEach(d => { %>
      <tr style="<%= d.active ? '' : 'opacity:.5' %>">
        <td><a class="odkaz-ink" href="<%= base %>/sprava/dodavatel/<%= d.id %>"><b><%= d.name %></b></a>
          <div style="font-size:12px;color:var(--steel)"><%= d.address || '' %><%= d.ico ? ' · IČO ' + d.ico : '' %></div></td>
        <td><%= d.contact_person || '—' %></td>
        <td class="mono" style="font-size:12px"><%= d.email || '—' %></td>
        <td class="mono" style="font-size:12px"><%= d.phone || '—' %></td>
        <td class="num"><%= d.pocet_poloziek %></td>
        <td class="mono" style="font-size:12px"><%= d.lead_time_days %> dní</td>
        <td><a class="btn sec sm" href="<%= base %>/sprava/dodavatel/<%= d.id %>">Upraviť</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/foot') %>
