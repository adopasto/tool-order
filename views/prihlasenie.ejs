<%- include('partials/head', { title: 'Prihlásenie', nav: '' }) %>

<div class="login">
  <div class="eyebrow" style="text-align:center;margin-bottom:6px">NEWAYS Slovakia, a.s.</div>
  <h1 style="text-align:center">Objednávky náradia</h1>
  <p class="sub" style="text-align:center">Prihláste sa firemným kontom.</p>

  <div class="panel"><div class="panel-b">
    <% if (chyba) { %>
      <div class="flash" style="border-left-color:var(--zero)"><%= chyba %></div>
    <% } %>
    <form method="post" action="<%= base %>/prihlasenie">
      <div class="field">
        <label for="u">Používateľ</label>
        <input type="text" id="u" name="username" autofocus autocomplete="username" required>
      </div>
      <div class="field">
        <label for="p">Heslo</label>
        <input type="password" id="p" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn" type="submit" style="width:100%">Prihlásiť sa</button>
    </form>
  </div></div>

  <div class="panel" style="margin-top:14px"><div class="panel-b">
    <div class="eyebrow" style="margin-bottom:8px">Testovacie kontá (heslo = meno + 123)</div>
    <div class="demo">
      <% demo.forEach(d => { %><%= d.username.padEnd(10, '\u00a0') %> <%= d.full_name %> – <%= d.role %><br><% }) %>
    </div>
  </div></div>
</div>

<%- include('partials/foot') %>
