<%- include('partials/head', { title: novy ? 'Nový dodávateľ' : d.name, nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Dodávatelia', href:'/sprava/dodavatelia'},
               {text: novy ? 'Nový' : d.name}] }) %>

<h1><%= novy ? 'Nový dodávateľ' : d.name %></h1>
<p class="sub">Evidencia pre orientáciu – kto čo dodáva a za akú dobu.</p>

<form method="post" action="<%= base %>/sprava/dodavatel/<%= novy ? 'novy' : d.id %>" style="max-width:820px">
  <div class="panel"><div class="panel-b">
    <div class="formrow">
      <div class="field"><label for="name">Názov *</label>
        <input type="text" id="name" name="name" value="<%= d.name || '' %>" required></div>
      <div class="field" style="flex:0 0 150px"><label for="ico">IČO</label>
        <input class="mono" type="text" id="ico" name="ico" value="<%= d.ico || '' %>"></div>
    </div>
    <div class="formrow">
      <div class="field"><label for="contact_person">Kontaktná osoba</label>
        <input type="text" id="contact_person" name="contact_person" value="<%= d.contact_person || '' %>"></div>
      <div class="field"><label for="email">E-mail</label>
        <input type="text" id="email" name="email" value="<%= d.email || '' %>"></div>
      <div class="field"><label for="phone">Telefón</label>
        <input type="text" id="phone" name="phone" value="<%= d.phone || '' %>"></div>
    </div>
    <div class="formrow">
      <div class="field"><label for="address">Adresa</label>
        <input type="text" id="address" name="address" value="<%= d.address || '' %>"></div>
      <div class="field"><label for="web">Web</label>
        <input type="text" id="web" name="web" value="<%= d.web || '' %>"></div>
      <div class="field" style="flex:0 0 160px"><label for="lead_time_days">Dodacia lehota (dní)</label>
        <input type="number" id="lead_time_days" name="lead_time_days" value="<%= d.lead_time_days ?? 7 %>" min="0"></div>
    </div>
    <div class="field"><label for="note">Poznámka</label>
      <textarea id="note" name="note" rows="2"><%= d.note || '' %></textarea></div>
    <label class="check"><input type="checkbox" name="active" <%= (novy || d.active) ? 'checked' : '' %>> Aktívny</label>
  </div></div>

  <div style="display:flex;gap:10px;margin-top:16px">
    <button class="btn" type="submit">Uložiť</button>
    <a class="btn sec" href="<%= base %>/sprava/dodavatelia">Späť na zoznam</a>
  </div>
</form>

<% if (!novy) { %>
  <h2>Dodávané položky</h2>
  <div class="panel" style="max-width:820px">
    <table class="tbl">
      <thead><tr><th style="width:110px">Kód</th><th>Položka</th><th style="width:130px">Kat. č.</th>
                 <th class="num" style="width:90px">Cena</th></tr></thead>
      <tbody>
      <% if (polozky.length === 0) { %>
        <tr><td colspan="4" class="napoveda" style="padding:14px">
          Žiadne položky. Väzbu pridáš vo formulári konkrétnej položky.</td></tr>
      <% } %>
      <% polozky.forEach(i => { %>
        <tr>
          <td class="mono"><a href="<%= base %>/sprava/polozka/<%= i.id %>"><%= i.code %></a></td>
          <td><%= i.name %><%= i.is_primary ? ' · hlavný dodávateľ' : '' %></td>
          <td class="mono"><%= i.supplier_sku || '—' %></td>
          <td class="num"><%= i.price != null ? i.price.toFixed(2) + ' €' : '—' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

  <form method="post" action="<%= base %>/sprava/dodavatel/<%= d.id %>/zmazat" style="margin-top:24px"
        onsubmit="return confirm('Naozaj zmazať dodávateľa?')">
    <button class="btn warn sm" type="submit">Zmazať dodávateľa</button>
  </form>
<% } %>

<%- include('partials/foot') %>
