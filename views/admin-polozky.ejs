<%- include('partials/head', { title: 'Položky', nav: 'sprava',
      drobky: [{text:'Správa', href:'/sprava'}, {text:'Položky'}] }) %>

<div class="hlavicka">
  <div>
    <h1>Položky</h1>
    <p class="sub">Kliknutím na riadok otvoríš úpravu. Nové položky pribúdajú tlačidlom vpravo.</p>
  </div>
  <a class="btn" href="<%= base %>/sprava/polozka/nova">+ Nová položka</a>
</div>

<form class="toolbar" method="get" action="<%= base %>/sprava/polozky">
  <div class="grow"><input type="search" name="q" value="<%= q %>" placeholder="Hľadať podľa kódu alebo názvu"></div>
  <button class="btn sec" type="submit">Hľadať</button>
  <% if (q) { %><a class="btn sec" href="<%= base %>/sprava/polozky">Zrušiť</a><% } %>
</form>

<% if (polozky.length === 0) { %>
  <div class="empty">Žiadna položka nezodpovedá filtru.<br>
    <a class="btn sm" style="margin-top:12px" href="<%= base %>/sprava/polozka/nova">Založiť novú položku</a></div>
<% } else { %>
<div class="panel">
  <table class="tbl">
    <thead><tr><th style="width:56px">Foto</th><th style="width:100px">Kód</th><th>Názov</th>
               <th style="width:130px">Kategória</th><th style="width:70px">Regál</th>
               <th class="num" style="width:100px">Na sklade</th><th class="num" style="width:80px">Signálna</th>
               <th style="width:110px">Stav</th><th style="width:150px"></th></tr></thead>
    <tbody>
    <% polozky.forEach(p => { %>
      <tr style="<%= p.active ? '' : 'opacity:.5' %>">
        <td><a href="<%= base %>/sprava/polozka/<%= p.id %>"><%- include('partials/mini', { path: p.image_path, kod: p.code }) %></a></td>
        <td class="mono"><a href="<%= base %>/sprava/polozka/<%= p.id %>"><%= p.code %></a></td>
        <td><a class="odkaz-ink" href="<%= base %>/sprava/polozka/<%= p.id %>"><%= p.name %></a>
          <%= p.active ? '' : ' · neaktívna' %><%= p.is_esd ? ' · ESD' : '' %></td>
        <td style="color:var(--steel);font-size:13px"><%= p.cat_name || '—' %></td>
        <td class="mono" style="font-size:12px"><%= p.location || '—' %></td>
        <td class="num"><b><%= p.stock_qty %></b> <%= p.unit %></td>
        <td class="num" style="color:var(--steel)"><%= p.reorder_point %></td>
        <td><span class="tag <%= p.stav %>"><%= p.stav === 'ok' ? 'v poriadku' : (p.stav === 'nizka' ? 'nízka' : 'vypredané') %></span></td>
        <td style="display:flex;gap:6px">
          <a class="btn sec sm" href="<%= base %>/sprava/polozka/<%= p.id %>">Upraviť</a>
          <a class="btn sec sm" href="<%= base %>/produkt/<%= p.id %>">Karta</a>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('partials/foot') %>
